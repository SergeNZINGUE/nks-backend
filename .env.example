# Copier en .env (non versionné) et renseigner les valeurs réelles avant démarrage.

SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/nks_dev
DB_USERNAME=nks
DB_PASSWORD=nks

# JWT RS256 — obligatoire en prod (voir README "Générer les clés JWT")
JWT_PRIVATE_KEY_PATH=file:./keys/private_key.pem
JWT_PUBLIC_KEY_PATH=file:./keys/public_key.pem

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Cloudinary (stockage médias — ADR-04)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LigdiCash (paiement Mobile Money — ADR-05)
LIGDICASH_BASE_URL=https://app.ligdicash.com/pay/v01
LIGDICASH_API_KEY=
LIGDICASH_API_SECRET=
LIGDICASH_WEBHOOK_SECRET=
LIGDICASH_CALLBACK_BASE_URL=http://localhost:8080/api/v1

# Africa's Talking (SMS — H10)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=NKS

# SMTP (e-mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Votes sociaux Facebook — décision client : intégration API réelle (voir README
# "Configuration Meta / Facebook" pour la procédure complète d'obtention de ces valeurs).
# FACEBOOK_PAGE_ID       : identifiant numérique de la Page Facebook officielle NKS.
# FACEBOOK_ACCESS_TOKEN  : Page Access Token LONGUE DURÉE (ne pas utiliser un token
#                          "temporaire" de l'Explorateur Graph API, il expire en ~1h à 2 mois).
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# Votes sociaux TikTok — non configuré dans cette phase (hors périmètre de la demande actuelle).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
